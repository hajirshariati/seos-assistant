{% comment %}
  Hajirai AI Chat — app embed block.
  Merchants configure appearance and content here in the theme editor.
  Chat routing goes through the app proxy at /apps/hajirai/chat.
{% endcomment %}

{%- comment -%}
  The chat's words are no longer theme settings. Its name, greetings,
  message box and note come from the app (Settings → Look & feel → Chat
  text), with these as the built-in fallback; the Classic home's Start here
  and Popular buttons are built in. Aetrex keeps the words its theme had.
{%- endcomment -%}
{%- assign ava_words = false -%}
{%- if shop.permanent_domain == 'f031fc-3.myshopify.com' -%}{%- assign ava_words = true -%}{%- endif -%}
<script>
  window.__AI_CHAT_CONFIG = {
    shopDomain: {{ shop.permanent_domain | json }},
    shopName: {{ shop.name | json }},
    greeting: {% if ava_words %}"Hi! I'm Ava, your personal shopping assistant."{% else %}"Hi! I'm your personal shopping assistant."{% endif %},
    greetingLoggedIn: {% if ava_words %}"Welcome back, {name}!"{% else %}"Welcome back, {name}! How can I help you today?"{% endif %},
    greetingCta: {% if ava_words %}"How can I help you today?"{% else %}"What can I help you find today?"{% endif %},
    avatarUrl: {% if block.settings.avatar != blank %}{{ block.settings.avatar | image_url: width: 200 | json }}{% else %}""{% endif %},
    bannerUrl: {% if block.settings.banner != blank %}{{ block.settings.banner | image_url: width: 800 | json }}{% else %}""{% endif %},
    assistantName: {% if ava_words %}"Aetrex Virtual Assistant"{% else %}"AI Shopping Assistant"{% endif %},
    launcherPlaceholder: {% if ava_words %}"What can I help you find today?"{% else %}"How can I help you today?"{% endif %},
    inputPlaceholder: {% if ava_words %}"Chat with Aetrex virtual assistant"{% else %}"How can I help you today?"{% endif %},
    widgetPosition: {{ block.settings.position | json }},
    cta1Label: {% if ava_words %}"Shop Footwear"{% else %}"Shop Shoes"{% endif %},
    cta1Message: {% if ava_words %}"Help me find a comfort footwear"{% else %}"Help me choose Aetrex shoes based on my style, comfort needs, and activities."{% endif %},
    cta1Icon: {% if ava_words %}"auto"{% else %}"auto"{% endif %},
    cta2Label: {% if ava_words %}"Manage my order"{% else %}"Shop Orthotics"{% endif %},
    cta2Message: {% if ava_words %}"Show me my recent orders"{% else %}"Help me choose the right Aetrex orthotics based on my arch support needs, footwear, and daily activities."{% endif %},
    cta2Icon: {% if ava_words %}"auto"{% else %}"auto"{% endif %},
    cta3Label: {% if ava_words %}"Shop Orthotics"{% else %}"Size & Fit Help"{% endif %},
    cta3Message: {% if ava_words %}"Help me find an orthotic"{% else %}"Help me find the right Aetrex shoe size and fit."{% endif %},
    cta3Icon: {% if ava_words %}"auto"{% else %}"auto"{% endif %},
    cta4Label: {% if ava_words %}"About Aetrex"{% else %}"Track Order"{% endif %},
    cta4Message: {% if ava_words %}"Tell me about Aetrex"{% else %}"Help me check the status of my order."{% endif %},
    cta4Icon: {% if ava_words %}"auto"{% else %}"auto"{% endif %},
    ctaHint: {% if ava_words %}""{% else %}""{% endif %},
    ctaHintLoggedIn: {% if ava_words %}""{% else %}""{% endif %},
    quickPick1Label: {% if ava_words %}"Share feedback"{% else %}"Best Sellers"{% endif %},
    quickPick1Message: {% if ava_words %}"https://irle3andv1z.typeform.com/to/jdXBrXMa"{% else %}"Show me the most popular Aetrex products."{% endif %},
    quickPick2Label: {% if ava_words %}"New Arrivals"{% else %}"New Arrivals"{% endif %},
    quickPick2Message: {% if ava_words %}"Show me what's new"{% else %}"Show me the latest Aetrex shoes and orthotics."{% endif %},
    quickPick3Label: {% if ava_words %}"Return policy"{% else %}"Sale Items"{% endif %},
    quickPick3Message: {% if ava_words %}"What is your return and refund policy?"{% else %}"Show me Aetrex products currently on sale."{% endif %},
    quickPick4Label: {% if ava_words %}"Browse deals"{% else %}"Returns"{% endif %},
    quickPick4Message: {% if ava_words %}"Show me current sales and promotions"{% else %}"Help me understand Aetrex's return and exchange policy."{% endif %},
    showBanner: {{ block.settings.show_banner | json }},
    launcherWidth: {{ block.settings.launcher_width | json }},
    chatWidth: {{ block.settings.chat_width | json }},
    hideOnMobile: {{ block.settings.hide_on_mobile | json }},
    trueFit: {{ block.settings.truefit_size_finder | json }},
    trueFitLogo: {{ 'truefit-logo.png' | asset_url | json }},
    homeLayout: {{ block.settings.home_layout | json }},
    focusPainImages: { heel: {{ 'focus-pain-heel.png' | asset_url | json }}, arch: {{ 'focus-pain-arch.png' | asset_url | json }}, ball: {{ 'focus-pain-ball.png' | asset_url | json }}, toes: {{ 'focus-pain-toes.png' | asset_url | json }} },
    customerLoggedIn: {% if customer %}true{% else %}false{% endif %},
    customerFirstName: {% if customer %}{{ customer.first_name | json }}{% else %}""{% endif %},
    customerLoginUrl: {{ routes.account_login_url | json }},
    customerLogoutUrl: {{ routes.account_logout_url | json }},
    customerId: {% if customer %}{{ customer.id | json }}{% else %}null{% endif %},
    disclaimerText: {% if ava_words %}"Virtual assistant responses may be inaccurate and are not medical advice. Chats may be recorded and shared with third-party providers. Do not share sensitive personal, payment, or health information. See our"{% else %}"Powered by AI"{% endif %},
    privacyUrl: {{ block.settings.privacy_url | json }},
    supportUrl: {{ block.settings.support_url | json }}
  };
</script>

<style>
  .ai-chat-overlay.visible { background: rgba(0, 0, 0, 0.4) !important; }
  .ai-chat-panel { --ai-chat-panel-w: 560px !important; }
  /* While the chat is open, the page behind it is blurred and inert. */
  body.ai-chat-blurred > *:not(.ai-chat-overlay):not(.ai-chat-panel):not(.ai-chat-launcher) {
    filter: blur(6px) !important;
    pointer-events: none !important;
    user-select: none !important;
  }
  body.ai-chat-blurred { overflow: hidden !important; }
  .ai-chat-suggestions {
    display: flex !important;
    flex-direction: column;
    gap: 8px;
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px solid #eee;
  }
  .ai-chat-suggest-btn {
    display: flex !important;
    align-items: flex-start;
    gap: 8px;
    padding: 10px 14px;
    border-radius: 10px;
    border: 1.5px solid var(--ai-chat-cta-bg, #e8f5ee);
    background: var(--ai-chat-cta-bg, #e8f5ee);
    cursor: pointer;
    color: var(--ai-chat-cta-text, #2d6b4f);
    font-size: 13px;
    font-family: inherit;
    font-weight: 500;
    line-height: 1.4;
    text-align: left;
  }
  .suggest-plus {
    color: var(--ai-chat-color-primary, #2d6b4f);
    font-weight: 700;
    font-size: 15px;
    flex-shrink: 0;
  }
</style>

<link rel="stylesheet" href="{{ 'hajirai-chat-widget.css' | asset_url }}">
<script src="{{ 'hajirai-chat-widget.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "SEoS Assistant",
  "target": "body",
  "settings": [
    {
      "type": "paragraph",
      "content": "The chat's words (its name, greetings, message box, note, and the Focus home's cards and links) are set in the AVA app → Settings → Look & feel."
    },
    {
      "type": "header",
      "content": "Assistant Identity"
    },
    {
      "type": "image_picker",
      "id": "avatar",
      "label": "Avatar Image"
    },
    {
      "type": "image_picker",
      "id": "banner",
      "label": "Welcome Banner"
    },
    {
      "type": "checkbox",
      "id": "show_banner",
      "label": "Show banner on welcome screen",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "position",
      "label": "Launcher Position",
      "options": [
        {
          "value": "bottom-center",
          "label": "Bottom Center"
        },
        {
          "value": "bottom-left",
          "label": "Bottom Left"
        },
        {
          "value": "bottom-right",
          "label": "Bottom Right"
        }
      ],
      "default": "bottom-center"
    },
    {
      "type": "text",
      "id": "launcher_width",
      "label": "Launcher Width (px)",
      "default": "500",
      "info": "Total width of the launcher bar, in pixels."
    },
    {
      "type": "text",
      "id": "chat_width",
      "label": "Chatbot Width (px)",
      "info": "Width of the open chat panel. Defaults to the launcher width if left blank.",
      "default": "560"
    },
    {
      "type": "checkbox",
      "id": "hide_on_mobile",
      "label": "Hide chatbot on mobile",
      "info": "Hides the launcher and chat panel on screens narrower than 768px.",
      "default": false
    },
    {
      "type": "select",
      "id": "home_layout",
      "label": "Home layout",
      "info": "Classic is the current welcome screen. Focus opens on the foot-pain question with six places it can hurt, then Footwear and Orthotics as two cards whose tools open in a sheet. Try it on a draft theme first. (Rotating the welcome line through languages is set in the app's Settings.)",
      "options": [
        {
          "value": "classic",
          "label": "Classic"
        },
        {
          "value": "focus",
          "label": "Focus — foot pain specialist first"
        }
      ],
      "default": "classic"
    },
    {
      "type": "paragraph",
      "content": "Custom launcher: add the attribute data-open-ai-chat to any link, button, image, or text and clicking it will open the chatbot. Example: <a href=\"#\" data-open-ai-chat>Chat with us</a> — works even when the chatbot is hidden on mobile."
    },
    {
      "type": "header",
      "content": "Welcome CTAs & Quick Picks",
      "info": "Up to 4 starting questions, plus shorter quick-pick prompts."
    },
    {
      "type": "checkbox",
      "id": "truefit_size_finder",
      "label": "Open True Fit from the chat",
      "info": "Shows \"Find my shoe size\" (True Fit) on the chat's home screen and on shoe cards. Needs True Fit's \"Find my size\" on your shoe product pages; turn off if your store doesn't have it.",
      "default": true
    },
    {
      "type": "header",
      "content": "Customer Service Handoff",
      "info": "Shown if the chat fails or the assistant can't answer."
    },
    {
      "type": "url",
      "id": "support_url",
      "label": "Support URL (help center, contact page, live chat link)",
      "info": "Used when the app's Settings → Support link URL is blank. The button's text is set there too."
    },
    {
      "type": "url",
      "id": "privacy_url",
      "label": "Privacy Policy URL"
    }
  ]
}
{% endschema %}
