{% comment %}
  Hajirai AI Chat — app embed block.
  Merchants configure appearance and content here in the theme editor.
  Chat routing goes through the app proxy at /apps/hajirai/chat.
{% endcomment %}

<script>
  window.__AI_CHAT_CONFIG = {
    shopDomain: {{ shop.permanent_domain | json }},
    greeting: {{ block.settings.greeting | json }},
    greetingLoggedIn: {{ block.settings.greeting_logged_in | json }},
    greetingCta: {{ block.settings.greeting_cta | json }},
    avatarUrl: {% if block.settings.avatar != blank %}{{ block.settings.avatar | image_url: width: 200 | json }}{% else %}""{% endif %},
    bannerUrl: {% if block.settings.banner != blank %}{{ block.settings.banner | image_url: width: 800 | json }}{% else %}""{% endif %},
    assistantName: {{ block.settings.assistant_name | json }},
    launcherPlaceholder: {{ block.settings.launcher_placeholder | json }},
    inputPlaceholder: {{ block.settings.input_placeholder | json }},
    widgetPosition: {{ block.settings.position | json }},
    cta1Label: {{ block.settings.cta1_label | json }},
    cta1Message: {{ block.settings.cta1_message | json }},
    cta1Icon: {{ block.settings.cta1_icon | json }},
    cta2Label: {{ block.settings.cta2_label | json }},
    cta2Message: {{ block.settings.cta2_message | json }},
    cta2Icon: {{ block.settings.cta2_icon | json }},
    cta3Label: {{ block.settings.cta3_label | json }},
    cta3Message: {{ block.settings.cta3_message | json }},
    cta3Icon: {{ block.settings.cta3_icon | json }},
    cta4Label: {{ block.settings.cta4_label | json }},
    cta4Message: {{ block.settings.cta4_message | json }},
    cta4Icon: {{ block.settings.cta4_icon | json }},
    ctaHint: {{ block.settings.cta_hint | json }},
    ctaHintLoggedIn: {{ block.settings.cta_hint_logged_in | json }},
    quickPick1Label: {{ block.settings.qp1_label | json }},
    quickPick1Message: {{ block.settings.qp1_message | json }},
    quickPick2Label: {{ block.settings.qp2_label | json }},
    quickPick2Message: {{ block.settings.qp2_message | json }},
    quickPick3Label: {{ block.settings.qp3_label | json }},
    quickPick3Message: {{ block.settings.qp3_message | json }},
    quickPick4Label: {{ block.settings.qp4_label | json }},
    quickPick4Message: {{ block.settings.qp4_message | json }},
    showBanner: {{ block.settings.show_banner | json }},
    launcherWidth: {{ block.settings.launcher_width | json }},
    chatWidth: {{ block.settings.chat_width | json }},
    hideOnMobile: {{ block.settings.hide_on_mobile | json }},
    trueFit: {{ block.settings.truefit_size_finder | json }},
    trueFitLogo: {{ 'truefit-logo.png' | asset_url | json }},
    rotateGreetingCta: {{ block.settings.rotate_greeting_cta | json }},
    customerLoggedIn: {% if customer %}true{% else %}false{% endif %},
    customerFirstName: {% if customer %}{{ customer.first_name | json }}{% else %}""{% endif %},
    customerLoginUrl: {{ routes.account_login_url | json }},
    customerLogoutUrl: {{ routes.account_logout_url | json }},
    customerId: {% if customer %}{{ customer.id | json }}{% else %}null{% endif %},
    disclaimerText: {{ block.settings.disclaimer | json }},
    privacyUrl: {{ block.settings.privacy_url | json }},
    supportUrl: {{ block.settings.support_url | json }},
    supportLabel: {{ block.settings.support_label | json }}
  };
</script>

<style>
  .ai-chat-overlay.visible { background: rgba(0, 0, 0, 0.4) !important; }
  .ai-chat-panel { --ai-chat-panel-w: 560px !important; }
  /* While the chat is open, the page behind it is blurred and inert. */
  body.ai-chat-blurred > *:not(.ai-chat-overlay):not(.ai-chat-panel):not(.ai-chat-launcher) {
    filter: blur(6px) !important;
    pointer-events: none !important;
    user-select: none !important;
  }
  body.ai-chat-blurred { overflow: hidden !important; }
  .ai-chat-suggestions {
    display: flex !important;
    flex-direction: column;
    gap: 8px;
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px solid #eee;
  }
  .ai-chat-suggest-btn {
    display: flex !important;
    align-items: flex-start;
    gap: 8px;
    padding: 10px 14px;
    border-radius: 10px;
    border: 1.5px solid var(--ai-chat-cta-bg, #e8f5ee);
    background: var(--ai-chat-cta-bg, #e8f5ee);
    cursor: pointer;
    color: var(--ai-chat-cta-text, #2d6b4f);
    font-size: 13px;
    font-family: inherit;
    font-weight: 500;
    line-height: 1.4;
    text-align: left;
  }
  .suggest-plus {
    color: var(--ai-chat-color-primary, #2d6b4f);
    font-weight: 700;
    font-size: 15px;
    flex-shrink: 0;
  }
</style>

<link rel="stylesheet" href="{{ 'hajirai-chat-widget.css' | asset_url }}">
<script src="{{ 'hajirai-chat-widget.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "SEoS Assistant",
  "target": "body",
  "settings": [
    { "type": "header", "content": "Assistant Identity" },
    {
      "type": "text",
      "id": "assistant_name",
      "label": "Assistant Name",
      "default": "AI Shopping Assistant"
    },
    {
      "type": "image_picker",
      "id": "avatar",
      "label": "Avatar Image"
    },
    {
      "type": "image_picker",
      "id": "banner",
      "label": "Welcome Banner"
    },
    {
      "type": "checkbox",
      "id": "show_banner",
      "label": "Show banner on welcome screen",
      "default": true
    },

    { "type": "header", "content": "Messages" },
    {
      "type": "textarea",
      "id": "greeting",
      "label": "Greeting",
      "default": "Hi! I'm your personal shopping assistant."
    },
    {
      "type": "textarea",
      "id": "greeting_logged_in",
      "label": "Greeting (logged in)",
      "info": "Personalized greeting for logged-in customers. Use {name} for their first name. Leave blank to use the default greeting.",
      "default": "Welcome back, {name}! How can I help you today?"
    },
    {
      "type": "text",
      "id": "greeting_cta",
      "label": "Greeting CTA",
      "default": "What can I help you find today?"
    },
    {
      "type": "text",
      "id": "launcher_placeholder",
      "label": "Launcher Placeholder",
      "default": "How can I help you today?"
    },
    {
      "type": "text",
      "id": "input_placeholder",
      "label": "Chat Input Placeholder",
      "default": "How can I help you today?"
    },

    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "position",
      "label": "Launcher Position",
      "options": [
        { "value": "bottom-center", "label": "Bottom Center" },
        { "value": "bottom-left", "label": "Bottom Left" },
        { "value": "bottom-right", "label": "Bottom Right" }
      ],
      "default": "bottom-center"
    },
    {
      "type": "text",
      "id": "launcher_width",
      "label": "Launcher Width (px)",
      "default": "500"
    },
    {
      "type": "text",
      "id": "chat_width",
      "label": "Chatbot Width (px)",
      "info": "Width of the open chat panel. Defaults to the launcher width if left blank.",
      "default": "560"
    },
    {
      "type": "checkbox",
      "id": "hide_on_mobile",
      "label": "Hide chatbot on mobile",
      "info": "Hides the launcher and chat panel on screens narrower than 768px.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "rotate_greeting_cta",
      "label": "Rotate Greeting CTA through 6 languages",
      "info": "Cross-fades the welcome line through Spanish, Arabic, Japanese, Hebrew, Hindi, and Farsi translations of your text — signals to international shoppers that the assistant understands them. Translations regenerate automatically (server-side, cached) whenever you edit the Greeting CTA above.",
      "default": true
    },
    {
      "type": "paragraph",
      "content": "Custom launcher: add the attribute data-open-ai-chat to any link, button, image, or text and clicking it will open the chatbot. Example: <a href=\"#\" data-open-ai-chat>Chat with us</a> — works even when the chatbot is hidden on mobile."
    },

    { "type": "header", "content": "Welcome CTAs & Quick Picks", "info": "Up to 4 starting questions, plus shorter quick-pick prompts." },
    {"type": "text", "id": "cta1_label", "label": "CTA 1 Label", "default": "Shop Shoes"},
    {"type": "text", "id": "cta1_message", "label": "CTA 1 Message", "default": "Help me choose Aetrex shoes based on my style, comfort needs, and activities."},
    {"type": "select", "id": "cta1_icon", "label": "CTA 1 Icon", "default": "auto", "options": [{"value": "auto", "label": "Automatic (from the label)"}, {"value": "search", "label": "Search"}, {"value": "sizing", "label": "Ruler (sizing)"}, {"value": "shoe", "label": "Shoe"}, {"value": "orthotic", "label": "Target (orthotics)"}, {"value": "order", "label": "Box (orders)"}, {"value": "shipping", "label": "Truck (shipping)"}, {"value": "returns", "label": "Return arrow"}, {"value": "deals", "label": "Tag (deals)"}, {"value": "gift", "label": "Gift"}, {"value": "heart", "label": "Heart"}, {"value": "star", "label": "Star"}, {"value": "support", "label": "Chat bubble (support)"}, {"value": "store", "label": "Map pin (stores)"}, {"value": "sparkle", "label": "Sparkle"}]},
    {"type": "text", "id": "cta2_label", "label": "CTA 2 Label", "default": "Shop Orthotics"},
    {"type": "text", "id": "cta2_message", "label": "CTA 2 Message", "default": "Help me choose the right Aetrex orthotics based on my arch support needs, footwear, and daily activities."},
    {"type": "select", "id": "cta2_icon", "label": "CTA 2 Icon", "default": "auto", "options": [{"value": "auto", "label": "Automatic (from the label)"}, {"value": "search", "label": "Search"}, {"value": "sizing", "label": "Ruler (sizing)"}, {"value": "shoe", "label": "Shoe"}, {"value": "orthotic", "label": "Target (orthotics)"}, {"value": "order", "label": "Box (orders)"}, {"value": "shipping", "label": "Truck (shipping)"}, {"value": "returns", "label": "Return arrow"}, {"value": "deals", "label": "Tag (deals)"}, {"value": "gift", "label": "Gift"}, {"value": "heart", "label": "Heart"}, {"value": "star", "label": "Star"}, {"value": "support", "label": "Chat bubble (support)"}, {"value": "store", "label": "Map pin (stores)"}, {"value": "sparkle", "label": "Sparkle"}]},
    {"type": "text", "id": "cta3_label", "label": "CTA 3 Label", "default": "Size & Fit Help"},
    {"type": "text", "id": "cta3_message", "label": "CTA 3 Message", "default": "Help me find the right Aetrex shoe size and fit."},
    {"type": "select", "id": "cta3_icon", "label": "CTA 3 Icon", "default": "auto", "options": [{"value": "auto", "label": "Automatic (from the label)"}, {"value": "search", "label": "Search"}, {"value": "sizing", "label": "Ruler (sizing)"}, {"value": "shoe", "label": "Shoe"}, {"value": "orthotic", "label": "Target (orthotics)"}, {"value": "order", "label": "Box (orders)"}, {"value": "shipping", "label": "Truck (shipping)"}, {"value": "returns", "label": "Return arrow"}, {"value": "deals", "label": "Tag (deals)"}, {"value": "gift", "label": "Gift"}, {"value": "heart", "label": "Heart"}, {"value": "star", "label": "Star"}, {"value": "support", "label": "Chat bubble (support)"}, {"value": "store", "label": "Map pin (stores)"}, {"value": "sparkle", "label": "Sparkle"}]},
    {"type": "text", "id": "cta4_label", "label": "CTA 4 Label", "default": "Track Order"},
    {"type": "text", "id": "cta4_message", "label": "CTA 4 Message", "default": "Help me check the status of my order."},
    {"type": "select", "id": "cta4_icon", "label": "CTA 4 Icon", "default": "auto", "options": [{"value": "auto", "label": "Automatic (from the label)"}, {"value": "search", "label": "Search"}, {"value": "sizing", "label": "Ruler (sizing)"}, {"value": "shoe", "label": "Shoe"}, {"value": "orthotic", "label": "Target (orthotics)"}, {"value": "order", "label": "Box (orders)"}, {"value": "shipping", "label": "Truck (shipping)"}, {"value": "returns", "label": "Return arrow"}, {"value": "deals", "label": "Tag (deals)"}, {"value": "gift", "label": "Gift"}, {"value": "heart", "label": "Heart"}, {"value": "star", "label": "Star"}, {"value": "support", "label": "Chat bubble (support)"}, {"value": "store", "label": "Map pin (stores)"}, {"value": "sparkle", "label": "Sparkle"}]},
    { "type": "text", "id": "cta_hint", "label": "CTA Hint Text", "info": "Shown under the welcome CTAs when the customer is NOT logged in. Becomes a clickable login link automatically." },
    { "type": "text", "id": "cta_hint_logged_in", "label": "CTA Hint Text (logged in)", "info": "Shown when the customer IS logged in. Use {name} for their first name. Leave blank to hide." },

    {"type": "text", "id": "qp1_label", "label": "Quick Pick 1 Label", "default": "Best Sellers"},
    {"type": "text", "id": "qp1_message", "label": "Quick Pick 1 Message", "default": "Show me the most popular Aetrex products."},
    {"type": "text", "id": "qp2_label", "label": "Quick Pick 2 Label", "default": "New Arrivals"},
    {"type": "text", "id": "qp2_message", "label": "Quick Pick 2 Message", "default": "Show me the latest Aetrex shoes and orthotics."},
    {"type": "text", "id": "qp3_label", "label": "Quick Pick 3 Label", "default": "Sale Items"},
    {"type": "text", "id": "qp3_message", "label": "Quick Pick 3 Message", "default": "Show me Aetrex products currently on sale."},
    {"type": "text", "id": "qp4_label", "label": "Quick Pick 4 Label", "default": "Returns"},
    {"type": "text", "id": "qp4_message", "label": "Quick Pick 4 Message", "default": "Help me understand Aetrex's return and exchange policy."},

    {
      "type": "checkbox",
      "id": "truefit_size_finder",
      "label": "Open True Fit from the chat",
      "info": "Shows \"Find my shoe size\" (True Fit) on the chat's home screen and on shoe cards. Needs True Fit's \"Find my size\" on your shoe product pages; turn off if your store doesn't have it.",
      "default": true
    },

    { "type": "header", "content": "Customer Service Handoff", "info": "Shown if the chat fails or the assistant can't answer." },
    {
      "type": "text",
      "id": "support_label",
      "label": "Support Button Label",
      "default": "Contact customer service"
    },
    {
      "type": "url",
      "id": "support_url",
      "label": "Support URL (help center, contact page, live chat link)",
      "info": "Leave blank to use your existing live chat (Zendesk / Gorgias / Intercom) if loaded on the page."
    },

    {
      "type": "text",
      "id": "disclaimer",
      "label": "Footer Disclaimer Text",
      "default": "Powered by AI"
    },
    {
      "type": "url",
      "id": "privacy_url",
      "label": "Privacy Policy URL"
    }
  ]
}
{% endschema %}
