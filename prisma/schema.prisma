generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken  String?
  refreshTokenExpires DateTime?
}

model ShopConfig {
  id                  String   @id @default(cuid())
  shop                String   @unique

  assistantName       String   @default("AI Shopping Assistant")
  assistantTagline    String   @default("Smart Support for Every Step")
  greeting            String   @default("Hi! I'm your personal shopping assistant.")
  greetingCta         String   @default("What can I help you find today?")
  avatarUrl           String   @default("")
  bannerUrl           String   @default("")
  colorPrimary        String   @default("#2d6b4f")
  colorAccent         String   @default("#e8f5ee")
  colorCtaBg          String   @default("#e8f5ee")
  colorCtaText        String   @default("#2d6b4f")
  colorCtaHover       String   @default("#d6eee0")

  launcherPlaceholder String   @default("How can I help you today?")
  inputPlaceholder    String   @default("How can I help you today?")
  launcherWidth       String   @default("500")
  widgetPosition      String   @default("bottom-center")
  showBanner          Boolean  @default(true)

  cta1Label           String   @default("")
  cta1Message         String   @default("")
  cta2Label           String   @default("")
  cta2Message         String   @default("")
  cta3Label           String   @default("")
  cta3Message         String   @default("")
  cta4Label           String   @default("")
  cta4Message         String   @default("")

  qp1Label            String   @default("")
  qp1Message          String   @default("")
  qp2Label            String   @default("")
  qp2Message          String   @default("")
  qp3Label            String   @default("")
  qp3Message          String   @default("")
  qp4Label            String   @default("")
  qp4Message          String   @default("")

  ctaHint             String   @default("")
  disclaimerText      String   @default("Powered by AI")
  privacyUrl          String   @default("/pages/privacy-policy")

  // Cached translations of greetingCta for the welcome-CTA rotator.
  // JSON: { phrase: "...", results: [{code,dir,text}, ...] }.
  // Generated on demand via Anthropic Haiku (greeting-translation.server.js)
  // and refreshed when the cached `phrase` no longer matches the
  // current greetingCta. Empty `{}` = not yet generated.
  greetingCtaTranslations String   @default("{}")
  // Merchant toggle to disable the multilingual rotator entirely.
  // Default true so existing installs get the rotator on first deploy;
  // merchants can opt out via the theme block.
  rotateGreetingCta       Boolean  @default(true)

  anthropicApiKey     String   @default("")
  anthropicModel      String   @default("claude-sonnet-4-6")
  modelStrategy       String   @default("smart")
  yotpoApiKey         String   @default("")
  aftershipApiKey     String   @default("")

  showFollowUps       Boolean  @default(true)
  showFeedback        Boolean  @default(true)
  deduplicateColors   Boolean  @default(false)
  promptCaching       Boolean  @default(false)
  // Product card layout in the storefront chat widget.
  // "horizontal" (default): legacy — thumbnail left, title/price right,
  // capped at 3 cards stacked vertically. "showcase": square image
  // top, title/price/CTA below, up to 10 cards in a horizontal
  // scroll-snap row. Per-shop merchant preference.
  productCardStyle    String   @default("horizontal")
  klaviyoFormId       String   @default("")
  klaviyoCompanyId    String   @default("")
  klaviyoListId       String   @default("")
  klaviyoPrivateKey   String   @default("")
  yotpoLoyaltyApiKey  String   @default("")
  yotpoLoyaltyGuid    String   @default("")
  loyaltyDisplay      String   @default("points")
  loyaltyPointsPerDollar Int    @default(100)
  loyaltyRounding     String   @default("exact")

  hideOnUrls             String   @default("[]")
  categoryExclusions     String   @default("[]")
  categoryGroups         String   @default("[]")
  querySynonyms          String   @default("[]")
  // Storefront search URL template with a {q} placeholder. When set,
  // every product-response turn emits a single auto-generated CTA
  // pointing at the storefront's search results page for the current
  // intent (gender + category + color + modifier). Replaces the older
  // per-collection-link table for shops that prefer the simpler model.
  // Example for Aetrex: "https://www.aetrex.com/collections/shop?q={q}&tab=products"
  // Empty string disables auto-CTA and falls back to the legacy
  // collectionLinks JSON. No data is lost when migrating.
  storefrontSearchUrlPattern String @default("")
  // CTA overrides — JSON array of rules:
  //   [{ modifier?, gender?, category?, url, label? }, ...]
  // When the conversation's resolved intent matches a rule (case-
  // insensitive; blank fields are wildcards), that rule's URL/label
  // override the auto-generated search CTA. Most-specific (most fields
  // set) wins. Use for dedicated landing pages like /collections/
  // womens-sale that don't surface well via ?q= search.
  ctaOverrides           String   @default("[]")
  // Welcome panel intro effect. One of: "none" | "internal" | "external".
  // - none: no animated effect on first open.
  // - internal: rotating gradient ring rendered INSIDE the panel border.
  // - external: rotating gradient halo OUTSIDE the panel (blurred outer
  //   shadow effect; rendered as a separate fixed-position element).
  welcomeGlowStyle       String   @default("internal")
  // Comma-separated hex colors used by the welcome glow animation.
  // 3+ colors recommended for a smooth gradient sweep. Empty falls
  // back to the default palette.
  welcomeGlowColors      String   @default("#6366f1,#a855f7,#ec4899,#f59e0b,#10b981,#06b6d4")
  // Welcome glow animation tuning. All exposed in admin so merchants
  // can dial the effect to taste without code changes.
  //   borderWidth: thickness of the sharp gradient line at the panel edge (px)
  //   size:        how far the soft halo extends outside the panel (px)
  //   fadeInMs:    fade-in duration in milliseconds
  //   holdMs:      time at full opacity before fade-out starts (ms)
  //   fadeOutMs:   fade-out duration in milliseconds
  //   speed:       animation speed multiplier (1.0 = default; 0.5 = half speed;
  //                2.0 = double speed). Controls rotation and breathing periods.
  welcomeGlowBorderWidth Int      @default(2)
  welcomeGlowSize        Int      @default(18)
  welcomeGlowFadeInMs    Int      @default(1500)
  welcomeGlowHoldMs      Int      @default(4000)
  welcomeGlowFadeOutMs   Int      @default(2000)
  welcomeGlowSpeed       Float    @default(1.0)
  similarMatchAttributes String   @default("[]")
  collectionLinks        String   @default("[]")
  fitPredictorEnabled    Boolean  @default(false)
  fitPredictorConfig     String   @default("{}")

  // Semantic search (opt-in per merchant). Provider is one of "", "voyage",
  // or "openai". Empty disables semantic search; keyword search is used.
  // API keys are encrypted at rest using app/utils/encryption.server.js.
  embeddingProvider      String   @default("")
  voyageApiKey           String   @default("")
  openaiApiKey           String   @default("")

  // "Visualize My Look": AI styling-preview image for a single
  // recommended product. imageProvider selects which API powers it
  // ("gemini" | "openai"); openaiApiKey above is reused for OpenAI,
  // geminiApiKey is the new Google AI key (encrypted). The CTA label
  // is merchant-editable.
  visualizeLookEnabled   Boolean  @default(false)
  imageProvider          String   @default("")
  geminiApiKey           String   @default("")
  visualizeLookLabel     String   @default("Visualize My Look")

  supportUrl          String   @default("")
  supportLabel        String   @default("Contact customer service")
  trackingPageUrl     String   @default("")
  returnsPageUrl      String   @default("")
  referralPageUrl     String   @default("")

  vipModeEnabled      Boolean  @default(false)
  showLoginPill       Boolean  @default(true)

  // CS-team cheat code: when a customer (or CS agent posing as one)
  // types this exact phrase in chat, the response is a server-built
  // dump of every currently-active campaign. Bypasses the AI for
  // determinism. Empty = feature disabled.
  campaignCheatCode   String   @default("")

  // RAG over knowledge files. When true, chat-prompt.server.js
  // retrieves the top-K most semantically relevant KnowledgeChunk
  // rows for the customer's latest message and injects only those
  // — instead of dumping every knowledge file in every prompt.
  // Default OFF: feature must be opted into per-shop. Requires
  // semantic search (embeddingProvider + apiKey) + a successful
  // backfill (npm run backfill:knowledge-chunks) before enabling.
  knowledgeRagEnabled Boolean  @default(false)

  // Decision Tree Engine — clinical/expert funnels (e.g. Aetrex's
  // orthotic finder). When true, an active DecisionTree row whose
  // intent matches the customer's current category will run a
  // deterministic question funnel, bypassing the LLM during its
  // active turns and returning the next question directly. Default
  // OFF — a merchant must (1) define a tree in the admin and
  // (2) flip this flag before customers see any funnel UX.
  // Existing chat behavior is identical when this flag is false.
  decisionTreeEnabled Boolean  @default(false)

  plan                    String    @default("free")
  subscriptionId          String?
  subscriptionActivatedAt DateTime?

  rateLimitHits      Int      @default(0)
  rateLimitHitsMonth String   @default("")

  dailyCapEnabled    Boolean  @default(false)
  dailyCapMessages   Int      @default(200)

  // Updated on each /widget-config call from the storefront, throttled to
  // once every 5 minutes. Used by the home-page setup checklist to detect
  // whether the chat widget app embed is currently active in the merchant's
  // theme. Null means the widget has never been seen.
  lastWidgetSeenAt   DateTime?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model KnowledgeFile {
  id        String   @id @default(cuid())
  shop      String
  fileName  String
  fileType  String
  fileSize  Int
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shop])
}

model Product {
  id               String           @id @default(cuid())
  shop             String
  shopifyId        String
  handle           String
  title            String
  vendor           String?
  productType      String?
  tags             String[]
  description      String?
  status           String?
  featuredImageUrl String?
  attributesJson   Json?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  variants         ProductVariant[]

  @@unique([shop, shopifyId])
  @@index([shop])
  @@index([shop, handle])
}

model ProductVariant {
  id               String   @id @default(cuid())
  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  shopifyId        String
  sku              String?
  title            String?
  price            String?
  compareAtPrice   String?
  inventoryQty     Int?
  optionsJson      String?
  attributesJson   Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([productId, shopifyId])
  @@index([sku])
}

model AttributeMapping {
  id         String   @id @default(cuid())
  shop       String
  attribute  String
  sourceType String
  target     String   @default("product")
  namespace  String?
  key        String?
  prefix     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([shop, attribute])
  @@index([shop])
}

model CatalogSyncState {
  id            String    @id @default(cuid())
  shop          String    @unique
  status        String    @default("idle")
  lastSyncedAt  DateTime?
  lastError     String?
  productsCount Int       @default(0)
  syncedSoFar   Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model ProductEnrichment {
  id             String   @id @default(cuid())
  shop           String
  sku            String
  data           Json
  sourceFileId   String?
  sourceFileType String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([shop, sku])
  @@index([shop])
  @@index([sourceFileId])
}

model ChatUsage {
  id                       String   @id @default(cuid())
  shop                     String
  model                    String
  inputTokens              Int      @default(0)
  outputTokens             Int      @default(0)
  cacheCreationInputTokens Int      @default(0)
  cacheReadInputTokens     Int      @default(0)
  costUsd                  Float    @default(0)
  toolCalls                Int      @default(0)
  // Semantic-search (embedding) usage for this chat turn — query
  // embeddings only (product search + RAG retrieval), priced separately
  // from Anthropic tokens since the merchant pays Voyage/OpenAI directly.
  embeddingTokens          Int      @default(0)
  embeddingCostUsd         Float    @default(0)
  // "Visualize My Look" styling-preview image generations this turn,
  // priced separately (merchant pays Gemini/OpenAI directly).
  imageCount               Int      @default(0)
  imageCostUsd             Float    @default(0)
  // Admin test chats: counted for the cost estimate only — never in customer
  // analytics, the daily cap or exports.
  internal                 Boolean  @default(false)
  createdAt                DateTime @default(now())

  @@index([shop])
  @@index([shop, createdAt])
}

model ChatFeedback {
  id           String   @id @default(cuid())
  shop         String
  sessionId    String
  vote         String
  botResponse  String
  products     String[]
  conversation String?
  userHash     String?
  createdAt    DateTime @default(now())

  @@index([shop])
  @@index([shop, createdAt])
  @@index([createdAt])
}

// What each storefront chat turn was about — search filters, store
// questions (answered or not), support hand-offs, store tools used. Never
// the customer's words or anything identifying them. Kept 90 days.
model ChatTopic {
  id        String   @id @default(cuid())
  shop      String
  kind      String
  value     String   @default("")
  createdAt DateTime @default(now())

  @@index([shop, createdAt])
  @@index([createdAt])
}

model ChatProductMention {
  id        String   @id @default(cuid())
  shop      String
  handle    String
  title     String
  tool      String
  createdAt DateTime @default(now())

  @@index([shop])
  @@index([shop, createdAt])
  @@index([shop, handle])
  @@index([createdAt])
}

// One row per scheduled marketing campaign. The chat reads only
// campaigns where now is between startsAt and endsAt — auto-expires
// without manual cleanup. Multiple active campaigns can run at once
// (BOGO + sitewide % off + free shipping over $X all coexist).
model Campaign {
  id        String   @id @default(cuid())
  shop      String
  name      String
  content   String   // Markdown-ish text the chat reads as system context
  startsAt  DateTime
  endsAt    DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shop])
  @@index([shop, startsAt, endsAt])
}

// One row per order whose orders/create webhook arrived with the
// _seos_attributed cart attribute set by the chat widget on a product
// click. Lets the analytics + home page show "Chat-driven sales:
// N orders / $X revenue" without an extra Shopify API call.
//
// Idempotent on (shop, orderId) so webhook retries don't double-count.
model ChatConversion {
  id          String   @id @default(cuid())
  shop        String
  orderId     String
  orderName   String?
  totalAmount Float?
  currency    String?
  customerId  String?
  createdAt   DateTime @default(now())

  @@unique([shop, orderId])
  @@index([shop])
  @@index([shop, createdAt])
  @@index([createdAt])
}

// One row per merchant-defined decision tree (clinical/expert
// funnel). Each tree owns one intent slug — e.g. "orthotic",
// "mattress" — and a deterministic resolver that maps collected
// attribute answers to a master SKU (or short ranked list). Trees
// are interactive: while one is active, chat.jsx bypasses the LLM
// and returns each next question directly. Multiple trees per shop
// supported; intent collisions fall back to the existing
// category-intent disambiguation in chat-prompt.server.js.
//
// `definition` is a JSON document validated by
// app/lib/decision-tree-schema.server.js. Shape (high-level):
//   {
//     rootNodeId: "q_gender",
//     nodes: [
//       { id, type: "question"|"resolve",
//         attribute, question, chips: [{label,value}],
//         next: { "<chipValue>": "<nodeId>" } | null,
//         skipIfKnown: bool },
//       ...
//     ],
//     resolver: {
//       defaults: { arch: "Medium / High Arch" },
//       rules: [
//         { when: { gender:"Men", useCase:"Dress", arch:"...", posted:false, met:false },
//           masterSku: "L100M", title: "Men's In-Style Orthotics" },
//         ...
//       ],
//       fallback: { masterSku: "...", reason: "..." }
//     }
//   }
//
// Pure data — no executable code. Same answers in always yields the
// same SKU out. The resolver's `rules` are evaluated top-down by the
// engine; first match wins. `defaults` fill unanswered attributes
// (e.g. "I don't know my arch" → Medium / High Arch).
model DecisionTree {
  id                   String   @id @default(cuid())
  shop                 String
  name                 String                 // human-readable label, shown in admin
  intent               String                 // slug, e.g. "orthotic"
  triggerPhrases       String   @default("[]") // JSON array of phrases that activate this tree
  triggerCategoryGroup String?                // optional: only fire when categoryIntent.activeGroup matches this
  definition           Json                   // tree shape — see comment above
  enabled              Boolean  @default(false)

  // Lifetime counters — analytics-only, incremented atomically.
  startedCount         Int      @default(0)
  completedCount       Int      @default(0)

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([shop, intent])
  @@index([shop])
  @@index([shop, enabled])
}

// One row per chunk of a merchant's knowledge file (FAQs, brand
// voice, rules, etc.). Used by the RAG path in chat-prompt.server.js
// — instead of injecting the entire knowledge corpus on every turn
// (~10-30K chars), we embed each chunk once and retrieve the top-K
// most semantically relevant ones for the customer's current message.
//
// Chunks are typically split on section headers (Aetrex's `═══`
// dividers) so each chunk is a coherent topic. The embedding column
// itself is `vector(1024)` and lives outside the Prisma schema —
// added via raw SQL in the migration since Prisma doesn't natively
// support pgvector. Same pattern as Product.embedding.
//
// On knowledge-file update, all chunks for that sourceFileId are
// deleted and replaced (idempotent rebuild).
model KnowledgeChunk {
  id                 String    @id @default(cuid())
  shop               String
  sourceFileId       String?
  fileType           String
  sectionTitle       String?
  chunkIndex         Int
  content            String
  embeddingProvider  String?
  embeddingUpdatedAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([shop])
  @@index([shop, fileType])
  @@index([sourceFileId])
}

// ─────────────────────────────────────────────────────────────────
// Catalog brain (Milestone 1, 2026-05-13). Derived from existing
// Product / ProductVariant / AttributeMapping rows — not synced
// directly from Shopify. Rebuilt by app/lib/catalog-facts.server.js
// on every product upsert/delete + nightly full rebuild.
//
// CatalogFact stores normalized facts per product (and optionally
// per variant). CatalogFacetIndex stores the per-shop matrices the
// resolver uses to detect impossible / inferable constraints
// without scanning the full catalog at chat time.
//
// Availability rule: a product is `available` if ANY variant has
// inventoryQty > 0 OR inventoryQty == null (untracked). Matches
// existing semantics in chat-tools.server.js.
//
// Uniqueness: factKey is non-null and unique within shop.
//   - product rows: factKey = "product:<productId>"
//   - variant rows: factKey = "variant:<variantId>"
// Postgres treats multiple NULLs as distinct so variantSku alone
// would not enforce uniqueness — factKey avoids that trap.
// ─────────────────────────────────────────────────────────────────
model CatalogFact {
  id                 String    @id @default(cuid())
  shop               String
  factKey            String
  productHandle      String
  productId          String
  variantId          String?
  variantSku         String?

  title              String
  category           String?
  productType        String?
  gender             String[]

  colors             String[]
  sizes              String[]
  widths             String[]

  conditionTags      String[]
  useCaseTags        String[]
  fitTags            String[]

  available          Boolean   @default(true)
  totalInventory     Int       @default(0)
  inventoryUntracked Boolean   @default(false)

  priceMin           Decimal?
  priceMax           Decimal?

  sourceUpdatedAt    DateTime?
  syncedAt           DateTime  @default(now()) @updatedAt

  @@unique([shop, factKey])
  @@index([shop])
  @@index([shop, available])
  @@index([shop, category, available])
}

model CatalogFacetIndex {
  id                       String    @id @default(cuid())
  shop                     String    @unique

  categoryByGender         Json      // { "sandals": ["women"], "sneakers": ["men","women"], ... }
  colorByGenderCategory    Json      // { "women:sandals": ["red","tan","black"], ... }
  conditionByCategory      Json      // { "sandals": ["plantar_fasciitis", ...], ... }
  sizeByGenderCategory     Json      // { "men:sneakers": ["8","8.5","9",...], ... }

  totalProducts            Int       @default(0)
  availableProducts        Int       @default(0)
  syncedAt                 DateTime  @default(now()) @updatedAt
}

// Merchant-data-driven claim rules. A ClaimRule says "for THIS shop,
// this verifier claim (e.g. archSupport, waterFriendly) is proven
// when a product belongs to category-group GROUP and not in EXCLUSIONS."
// Replaces the previous hardcoded BRAND_RULES + FOOTWEAR_CATEGORIES
// constants. Default seed runs on first request per shop —
// idempotent, mirrors the prior code defaults so existing installs
// inherit the same behavior without an admin action.
model ClaimRule {
  id              String   @id @default(cuid())
  shop            String
  claim           String   // canonical claim key: archSupport | waterFriendly | ...
  ruleType        String   // category_group | tag_match | metafield_match
  appliesToGroup  String?  // CategoryGroup.name when ruleType=category_group
  excludeGroups   String[] @default([])
  ruleConfig      Json?    // extensible per-ruleType payload
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([shop, claim])
  @@index([shop])
}

// Named groups of canonical categories. A merchant declares
// "Footwear = sneakers, sandals, boots, …" once; ClaimRule and the
// product turn engine reference the group name. New categories
// added to the catalog automatically flow into the group when the
// merchant updates it.
model CategoryGroup {
  id          String   @id @default(cuid())
  shop        String
  name        String   // e.g. "Footwear", "Accessories", "Orthotics"
  categories  String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([shop, name])
  @@index([shop])
}

// Named color families for "X or Y / neutral / earth tones" style
// queries. Resolver consults these before falling back to a
// single-color filter. No code list of "neutral colors" anywhere —
// the merchant defines what neutral means for their catalog.
model ColorFamily {
  id          String   @id @default(cuid())
  shop        String
  name        String   // e.g. "neutral", "earth-tones", "brights"
  members     String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([shop, name])
  @@index([shop])
}

// Live "viewing now" signal for the storefront social-proof popup.
// One row per (shop, product, anonymous tab). A session counts as
// "viewing" if it pinged in the last 60s (see SocialProof.server.js).
// Stale rows are swept opportunistically by the social-proof action.
model ProductViewerPing {
  id        String   @id @default(cuid())
  shop      String
  productId String
  sessionId String
  lastSeen  DateTime @default(now())

  @@unique([shop, productId, sessionId])
  @@index([shop, productId, lastSeen])
  @@index([lastSeen])
}

// Real recent purchases for the social-proof popup, recorded by the
// orders/create webhook. City only — deliberately no customer name or
// email — so the storefront can show "Someone in [City] just bought this".
model RecentPurchase {
  id           String   @id @default(cuid())
  shop         String
  orderId      String
  productId    String
  productTitle String?
  city         String?
  createdAt    DateTime @default(now())

  @@unique([shop, orderId, productId])
  @@index([shop, productId, createdAt])
  @@index([createdAt])
}

// Customer Account API (Customer Accounts MCP) auth state + tokens.
// Two phases share one row, looked up by `state`:
//   1. PKCE in-flight: state + codeVerifier saved before redirecting the
//      shopper to Shopify's hosted login.
//   2. Token: after the callback exchanges the code, the access/refresh
//      tokens (scoped to that one signed-in customer) are stored here.
// Used ONLY when CUSTOMER_ACCOUNT_MCP_ENABLED is on. Additive table —
// nothing else references it, so it can't affect existing behavior.
model CustomerAccountToken {
  id            String    @id @default(cuid())
  shop          String
  storefrontDomain String?
  chatSessionId String?
  state         String?   @unique
  codeVerifier  String?
  customerId    String?
  accessToken   String?
  refreshToken  String?
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([shop, customerId])
  @@index([shop, chatSessionId])
}
